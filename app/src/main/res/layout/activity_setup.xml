<?xml version="1.0" encoding="utf-8"?>
<!--
    First-run screen. Scrollable because the error message can be several lines
    long on a short device, and the Retry button must always be reachable.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/accent"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/setup_title"
            android:textColor="@color/text"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/setup_intro"
            android:textColor="@color/textDim"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <!-- Progress card -->
        <LinearLayout
            android:id="@+id/setupProgressCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card_soft"
            android:padding="16dp">

            <ProgressBar
                android:id="@+id/setupProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:indeterminate="true"
                android:max="100"
                android:progressTint="@color/accent"
                android:progressBackgroundTint="@color/border"
                android:indeterminateTint="@color/accent" />

            <TextView
                android:id="@+id/setupPhase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/setup_phase_starting"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/setupNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/setup_note"
                android:textColor="@color/textFaint"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- Error card. Hidden until something actually goes wrong. -->
        <LinearLayout
            android:id="@+id/setupErrorCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card_soft"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_failed_title"
                android:textColor="@color/danger"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/setup_failed_help"
                android:textColor="@color/textDim"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <!-- Monospace and selectable: this is the text we ask people to send us. -->
            <TextView
                android:id="@+id/setupError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/bg"
                android:padding="10dp"
                android:textColor="@color/textDim"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textIsSelectable="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/setupRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_btn_accent"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="11dp"
                    android:text="@string/setup_retry"
                    android:textAllCaps="false"
                    android:textColor="@color/bg"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/setupCopy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_btn_plain"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="11dp"
                    android:text="@string/setup_copy"
                    android:textAllCaps="false"
                    android:textColor="@color/text"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
