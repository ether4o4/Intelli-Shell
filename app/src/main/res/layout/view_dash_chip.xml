<?xml version="1.0" encoding="utf-8"?>
<!--
    One selectable chip. Deliberately a plain TextView rather than a Material Chip:
    Chip refuses to inflate unless the host theme descends from Theme.MaterialComponents,
    and the dashboard cannot make that assumption.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:background="@drawable/dash_bg_chip"
    android:clickable="true"
    android:focusable="true"
    android:paddingLeft="12dp"
    android:paddingTop="6dp"
    android:paddingRight="12dp"
    android:paddingBottom="6dp"
    android:textColor="@color/dash_text"
    android:textSize="13sp" />
