<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_bg"
    android:orientation="vertical">

    <!-- Colours are set here rather than inherited: the tab bar has to look right
         under whatever application theme hosts this activity. -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/dash_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dash_surface"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/dash_accent"
        app:tabIndicatorHeight="2dp"
        app:tabMode="fixed"
        app:tabRippleColor="@color/dash_accent_dim"
        app:tabSelectedTextColor="@color/dash_text"
        app:tabTextColor="@color/dash_muted" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/dash_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
