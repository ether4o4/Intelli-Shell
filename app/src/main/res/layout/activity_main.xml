<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- App bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="idle"
            android:textColor="@color/textFaint"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/stopBtn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/stop"
            android:textColor="@color/danger"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/dashBtn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:text="▦"
            android:textColor="@color/accent"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- CHAT pane (top). Weight is adjusted at runtime for the keyboard behavior. -->
    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="54"
        android:background="@color/bg"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/chatList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:background="@color/border" />

    <!-- TERMINAL pane (bottom) -->
    <FrameLayout
        android:id="@+id/terminalContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="46"
        android:background="@color/black" />

    <!-- Composer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:padding="8dp">

        <Button
            android:id="@+id/scriptsBtn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="8dp"
            android:text="📜"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/bg"
            android:hint="@string/chat_hint"
            android:textColorHint="@color/textFaint"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:padding="10dp"
            android:maxLines="4"
            android:inputType="textMultiLine|textCapSentences" />

        <Button
            android:id="@+id/sendBtn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/send"
            android:textColor="@color/accent"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
