<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_bg"
    android:fillViewport="true"
    android:padding="12dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Leads the tab on purpose: this store writes itself, and a user who does
             not know that will not think to correct it. -->
        <LinearLayout style="@style/DashCard">

            <TextView
                style="@style/DashTitle"
                android:text="@string/dash_memory_title" />

            <TextView
                style="@style/DashMuted"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/dash_memory_explainer" />

        </LinearLayout>

        <LinearLayout style="@style/DashCard">

            <TextView
                android:id="@+id/memory_editor_title"
                style="@style/DashTitle"
                android:text="@string/dash_memory_editor" />

            <TextView
                style="@style/DashLabel"
                android:text="@string/dash_memory_category" />

            <HorizontalScrollView
                android:id="@+id/memory_category_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/memory_category_strip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <EditText
                android:id="@+id/memory_content"
                style="@style/DashField"
                android:gravity="top|start"
                android:hint="@string/dash_memory_content_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/memory_save"
                    style="@style/DashButtonAccent"
                    android:text="@string/dash_save" />

                <Button
                    android:id="@+id/memory_clear"
                    style="@style/DashButton"
                    android:text="@string/dash_clear" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/memory_empty"
            style="@style/DashMuted"
            android:layout_marginTop="8dp"
            android:text="@string/dash_memory_empty"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/memory_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
