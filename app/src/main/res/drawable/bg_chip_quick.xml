<?xml version="1.0" encoding="utf-8"?>
<!--
    Quick-start suggestion chip. Pill-shaped and outlined rather than filled: the
    row sits directly above the composer, and a row of solid accent blocks there
    would read as five primary buttons competing with Send.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accentSoft" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/accent" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/border" />
        </shape>
    </item>

</selector>
