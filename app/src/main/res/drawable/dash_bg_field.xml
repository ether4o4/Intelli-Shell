<?xml version="1.0" encoding="utf-8"?>
<!-- Input fields sit *darker* than their card, which is what makes them read as
     editable on a surface this close to black. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/dash_bg" />
    <corners android:radius="8dp" />
    <stroke
        android:width="1dp"
        android:color="@color/dash_border" />
</shape>
