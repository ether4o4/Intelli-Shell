<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/dash_accent_dim" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/dash_accent" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dash_surface" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/dash_border" />
        </shape>
    </item>

</selector>
